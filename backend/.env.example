# Copy this file to .env and fill in your values
# cp .env.example .env

SECRET_KEY=your-50-char-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-domain.com,your-vps-ip

DB_NAME=naseri_erp_db
DB_USER=naseri_user
DB_PASSWORD=your-strong-db-password
DB_HOST=localhost
DB_PORT=5432

# Your frontend domain (same domain = no CORS needed, but set it anyway)
CORS_ALLOWED_ORIGINS=https://your-domain.com
