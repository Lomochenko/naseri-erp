# Copy these to Railway environment variables (Settings > Variables)

SECRET_KEY=your-strong-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-app.railway.app,your-custom-domain.com

# Railway provides DATABASE_URL automatically when you add a Postgres plugin
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# If NOT using Railway Postgres plugin, set these manually:
# DB_NAME=naseri_erp_db
# DB_USER=naseri_user
# DB_PASSWORD=your-db-password
# DB_HOST=your-db-host
# DB_PORT=5432

# Your Cloudflare Pages frontend URL
CORS_ALLOWED_ORIGINS=https://your-frontend.pages.dev,https://your-custom-domain.com
